# Optional. Rigless runs without a .env: pick RunPod or this computer on the app's ComfyUI tab.

# Passcode for the app, required to serve it beyond this computer (uv run rigless --host 0.0.0.0). Empty keeps it local-only.
RIGLESS_PASSCODE=
# A ComfyUI anywhere else: its comfy-api-proxy address. Set, it overrides the choice in the app.
COMFY_BASE_URL=
# That proxy's bearer token, if it has one.
COMFY_API_KEY=
# Hugging Face token, only to download models from a private repository (scripts/download_models.py).
HF_TOKEN=
