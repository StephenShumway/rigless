# Copy to .env and fill in only what you need. Local runs need none of these.

# Comfy API v2 endpoint. Empty means the local comfy-api-proxy at http://127.0.0.1:8189.
COMFY_BASE_URL=
# Bearer token for a remote proxy (RunPod) or a Comfy Cloud/Serverless API key. Empty for local runs.
COMFY_API_KEY=
# GPU settings preset from profiles/ (local-10gb, cloud-24gb, cloud-48gb). Empty means local-10gb.
RIGLESS_PROFILE=
